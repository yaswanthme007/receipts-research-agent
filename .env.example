# Copy to .env and fill in. Never commit .env.

# --- Nebius Token Factory (inference) ---
NEBIUS_API_KEY=your-token-factory-key
# Use the base URL your Token Factory dashboard shows.
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
# Fast model: planning, claim checking. Smart model: writing the answer.
# Run `python scripts/doctor.py` to list the models your key can use.
NEBIUS_MODEL_FAST=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEBIUS_MODEL_SMART=moonshotai/Kimi-K3
# Used automatically if a model is overloaded (529), rate-limited or missing.
NEBIUS_MODEL_FALLBACK=Qwen/Qwen3-30B-A3B-Instruct-2507

# --- Tavily (real-time web search) ---
TAVILY_API_KEY=your-tavily-key

# --- Research budget (optional) ---
RECEIPTS_MAX_ROUNDS=2
RECEIPTS_MAX_SOURCES=8
RECEIPTS_TAVILY_CREDIT_BUDGET=40
RECEIPTS_TIME_BUDGET_S=180
